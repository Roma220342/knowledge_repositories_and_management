# CQ01: Які HR-процеси (транзитивно) входять до управління персоналом?
# Очікуваний результат: [('appraisal1',), ('attestation2026',), ('interview1',), ('motivation1',), ('onboarding1',), ('recruitment1',), ('training1',)]
PREFIX hr: <http://example.org/hr#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?p WHERE { ?p (hr:subProcessOf|^hr:hasSubProcess)+ hr:personnelManagement }
