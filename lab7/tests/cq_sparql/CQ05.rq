# CQ05: Хто ухвалює кадрові рішення і які вони?
# Очікуваний результат: [('ivan', 'promotion1'), ('olena', 'dismissalProposal1')]
PREFIX hr: <http://example.org/hr#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?m ?d WHERE { ?m hr:makesDecision ?d . ?d rdf:type/rdfs:subClassOf* hr:HRDecision }
