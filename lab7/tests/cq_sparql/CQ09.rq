# CQ09: На яку посаду претендує кандидат 1 і яке резюме подав?
# Очікуваний результат: [('pythonDeveloperPost', 'resume1')]
PREFIX hr: <http://example.org/hr#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?pos ?r WHERE { hr:candidate1 hr:candidateFor ?pos ; hr:submittedResume ?r }
