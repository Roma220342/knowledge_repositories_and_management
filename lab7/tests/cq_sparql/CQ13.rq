# CQ13: Яка дія виконується в ситуації зі стану «випробувальний термін»?
# Очікуваний результат: [('actionConfirmEmployment',)]
PREFIX hr: <http://example.org/hr#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?a WHERE { ?t hr:fromState hr:stateProbation ; hr:performsAction ?a }
