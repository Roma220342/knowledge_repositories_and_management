hr:includesCourse a owl:ObjectProperty ;
    rdfs:label "включає курс"@uk ;
    rdfs:domain hr:TrainingPlan ;
    rdfs:range hr:Course .

hr:isOccupiedBy a owl:ObjectProperty ;
    rdfs:label "обіймається"@uk ;
    rdfs:domain hr:Position ;
    rdfs:range hr:Employee .

hr:lms1 a hr:LMS,
        owl:NamedIndividual ;
    hr:storesDocument hr:trainingPlanPetro ;
    hr:storesRecordOf hr:andriy,
        hr:maria .

hr:makesDecision a owl:ObjectProperty ;
    rdfs:label "ухвалює"@uk ;
    rdfs:domain hr:Manager ;
    rdfs:range hr:HRDecision .

hr:manages a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "керує"@uk ;
    rdfs:domain hr:Manager ;
    rdfs:range hr:Employee .

hr:personnelManagement a hr:HRProcess,
        owl:NamedIndividual ;
    hr:hasSubProcess hr:appraisal1,
        hr:motivation1,
        hr:recruitment1,
        hr:training1 .

hr:reportsTo a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "підпорядковується"@uk ;
    rdfs:domain hr:Employee ;
    rdfs:range hr:Manager ;
    owl:inverseOf hr:manages ;
    skos:closeMatch org:reportsTo .

hr:requiresDocument a owl:ObjectProperty ;
    rdfs:label "вимагає документ"@uk ;
    rdfs:domain hr:Recruitment ;
    rdfs:range hr:PositionProfile .

hr:salaryIvan a hr:Salary,
        owl:NamedIndividual ;
    hr:salaryAmount 3200.00 .

hr:situationS1 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Підтвердження після випробувального терміну"@uk ;
    hr:fromState hr:stateProbation ;
    hr:guard "productivityScore ≥ 6.0" ;
    hr:observedBy hr:sensorKPI ;
    hr:onEvent hr:eventProbationMaria ;
    hr:performsAction hr:actionConfirmEmployment ;
    hr:toState hr:stateActive .

hr:situationS2 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Ініціювання звільнення за низької продуктивності"@uk ;
    hr:fromState hr:stateActive ;
    hr:guard "productivityScore < 5.0 три квартали поспіль" ;
    hr:observedBy hr:sensorKPI ;
    hr:onEvent hr:eventLowProdPetro ;
    hr:performsAction hr:actionInitiateDismissal ;
    hr:toState hr:stateUnderReview .

hr:situationS3 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Початок адаптації нового співробітника"@uk ;
    hr:fromState hr:stateCandidate ;
    hr:guard "рішення про прийом схвалено керівником" ;
    hr:observedBy hr:sensorHRIS ;
    hr:onEvent hr:eventHire1 ;
    hr:performsAction hr:actionStartOnboarding ;
    hr:toState hr:stateOnboarding .

hr:situationS4 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Завершення курсу навчання"@uk ;
    hr:fromState hr:stateActive ;
    hr:guard "courseHours ≥ 8" ;
    hr:observedBy hr:sensorLMS ;
    hr:onEvent hr:eventCourseAndriy ;
    hr:performsAction hr:actionUpdateCompetence ;
    hr:toState hr:stateActive .

hr:situationS5 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Низька продуктивність: призначення курсу"@uk ;
    hr:fromState hr:stateActive ;
    hr:guard "5.0 ≤ productivityScore < 6.5" ;
    hr:observedBy hr:sensorKPI ;
    hr:onEvent hr:eventLowProdPetro ;
    hr:performsAction hr:actionAssignCourse ;
    hr:toState hr:stateActive .

hr:situationS6 a hr:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Заява про звільнення"@uk ;
    hr:fromState hr:stateActive ;
    hr:guard "заява зареєстрована в HRIS" ;
    hr:observedBy hr:sensorHRIS ;
    hr:onEvent hr:eventResignation1 ;
    hr:performsAction hr:actionCloseRecord ;
    hr:toState hr:stateDismissed .

hr:storesRecordOf a owl:ObjectProperty ;
    rdfs:label "зберігає дані про"@uk ;
    rdfs:domain hr:InformationSystem ;
    rdfs:range hr:Employee .

hr:ActiveState a owl:Class ;
    rdfs:label "Активний стан"@uk ;
    rdfs:comment "Стан співробітника, що працює на постійній основі."@uk ;
    rdfs:subClassOf hr:State .

hr:AssignCourseAction a owl:Class ;
    rdfs:label "Призначення курсу"@uk ;
    rdfs:comment "Дія призначення співробітнику курсу навчання."@uk ;
    rdfs:subClassOf hr:Action .

hr:Bonus a owl:Class ;
    rdfs:label "Премія"@uk ;
    rdfs:comment "Винагорода, що виплачується додатково за досягнуті результати."@uk ;
    rdfs:subClassOf hr:Reward .

hr:CandidateState a owl:Class ;
    rdfs:label "Стан кандидата"@uk ;
    rdfs:comment "Стан особи, яка перебуває на етапі відбору."@uk ;
    rdfs:subClassOf hr:State .

hr:CloseRecordAction a owl:Class ;
    rdfs:label "Закриття кадрового запису"@uk ;
    rdfs:comment "Дія завершення ведення активного кадрового запису."@uk ;
    rdfs:subClassOf hr:Action .

hr:ConfirmEmploymentAction a owl:Class ;
    rdfs:label "Підтвердження працевлаштування"@uk ;
    rdfs:comment "Дія переведення співробітника на постійну роботу."@uk ;
    rdfs:subClassOf hr:Action .

hr:Dismissal a owl:Class ;
    rdfs:label "Звільнення"@uk ;
    rdfs:comment "Кадрове рішення про припинення трудових відносин."@uk ;
    rdfs:subClassOf hr:HRDecision .

hr:DismissedState a owl:Class ;
    rdfs:label "Стан звільнення"@uk ;
    rdfs:comment "Стан особи, трудові відносини з якою припинено."@uk ;
    rdfs:subClassOf hr:State .

hr:HRIS a owl:Class ;
    rdfs:label "HRIS"@uk ;
    rdfs:comment "Інформаційна система обліку кадрових даних і підтримки HR-процесів."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hr:Employee ;
            owl:onProperty hr:storesRecordOf ],
        hr:InformationSystem .

hr:HRISSensor a owl:Class ;
    rdfs:label "Джерело HRIS"@uk ;
    rdfs:comment "Джерело даних, що фіксує кадрові події в HRIS."@uk ;
    rdfs:subClassOf hr:Sensor .

hr:HireEvent a owl:Class ;
    rdfs:label "Подія найму"@uk ;
    rdfs:comment "Подія, що фіксує ухвалення рішення про прийом кандидата."@uk ;
    rdfs:subClassOf hr:Event .

hr:InitiateDismissalAction a owl:Class ;
    rdfs:label "Ініціювання звільнення"@uk ;
    rdfs:comment "Дія запуску процедури звільнення."@uk ;
    rdfs:subClassOf hr:Action .

hr:Interview a owl:Class ;
    rdfs:label "Співбесіда"@uk ;
    rdfs:comment "HR-процес розмови з кандидатом для оцінки його відповідності посаді."@uk ;
    rdfs:subClassOf hr:HRProcess .

hr:KPISensor a owl:Class ;
    rdfs:label "Джерело KPI"@uk ;
    rdfs:comment "Джерело даних, що фіксує значення KPI та продуктивності."@uk ;
    rdfs:subClassOf hr:Sensor .

hr:LMS a owl:Class ;
    rdfs:label "LMS"@uk ;
    rdfs:comment "Інформаційна система управління навчанням, що зберігає курси та результати їх проходження."@uk ;
    rdfs:subClassOf hr:InformationSystem .

hr:LMSSensor a owl:Class ;
    rdfs:label "Джерело LMS"@uk ;
    rdfs:comment "Джерело даних, що фіксує проходження навчальних курсів."@uk ;
    rdfs:subClassOf hr:Sensor .

hr:OnboardingState a owl:Class ;
    rdfs:label "Стан адаптації"@uk ;
    rdfs:comment "Стан нового співробітника в період адаптації."@uk ;
    rdfs:subClassOf hr:State .

hr:ProbationReviewEvent a owl:Class ;
    rdfs:label "Підсумок випробувального терміну"@uk ;
    rdfs:comment "Подія, що фіксує оцінку результатів випробувального терміну."@uk ;
    rdfs:subClassOf hr:Event .

hr:ProbationState a owl:Class ;
    rdfs:label "Випробувальний термін"@uk ;
    rdfs:comment "Стан співробітника в період випробування."@uk ;
    rdfs:subClassOf hr:State .

hr:Productivity a owl:Class ;
    rdfs:label "Продуктивність"@uk ;
    rdfs:comment "Показник відношення результатів роботи співробітника до витрат часу та ресурсів."@uk ;
    rdfs:subClassOf hr:Metric .

hr:Promotion a owl:Class ;
    rdfs:label "Підвищення"@uk ;
    rdfs:comment "Кадрове рішення про переведення співробітника на вищу посаду."@uk ;
    rdfs:subClassOf hr:HRDecision .

hr:ResignationRequestEvent a owl:Class ;
    rdfs:label "Заява про звільнення"@uk ;
    rdfs:comment "Подія, що фіксує подання співробітником заяви про звільнення."@uk ;
    rdfs:subClassOf hr:Event .

hr:StartOnboardingAction a owl:Class ;
    rdfs:label "Запуск онбордингу"@uk ;
    rdfs:comment "Дія початку адаптації нового співробітника."@uk ;
    rdfs:subClassOf hr:Action .

hr:UnderReviewState a owl:Class ;
    rdfs:label "Стан розгляду"@uk ;
    rdfs:comment "Стан співробітника, щодо якого розглядається кадрове рішення."@uk ;
    rdfs:subClassOf hr:State .

hr:UpdateCompetenceAction a owl:Class ;
    rdfs:label "Оновлення компетенції"@uk ;
    rdfs:comment "Дія оновлення рівня компетенції співробітника в HRIS."@uk ;
    rdfs:subClassOf hr:Action .

hr:actionAssignCourse a hr:AssignCourseAction,
        owl:NamedIndividual .

hr:actionCloseRecord a hr:CloseRecordAction,
        owl:NamedIndividual .

hr:actionConfirmEmployment a hr:ConfirmEmploymentAction,
        owl:NamedIndividual .

hr:actionInitiateDismissal a hr:InitiateDismissalAction,
        owl:NamedIndividual .

hr:actionStartOnboarding a hr:StartOnboardingAction,
        owl:NamedIndividual .

hr:actionUpdateCompetence a hr:UpdateCompetenceAction,
        owl:NamedIndividual .

hr:affects a owl:ObjectProperty ;
    rdfs:label "впливає на"@uk ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( hr:Training hr:Motivation hr:Onboarding hr:HRDecision hr:Reward hr:Course ) ] ;
    rdfs:range hr:Metric .

hr:appraisal1 a hr:Appraisal,
