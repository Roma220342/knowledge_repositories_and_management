hr:fromState a owl:ObjectProperty ;
    rdfs:label "початковий стан"@uk ;
    rdfs:domain hr:SituationTemplate ;
    rdfs:range hr:State .

hr:fullName a owl:DatatypeProperty ;
    rdfs:label "ПІБ"@uk ;
    rdfs:domain hr:Person ;
    rdfs:range xsd:string ;
    skos:exactMatch foaf:name .

hr:guard a owl:DatatypeProperty ;
    rdfs:label "умова (guard)"@uk ;
    rdfs:domain hr:SituationTemplate ;
    rdfs:range xsd:string .

hr:hasCompetence a owl:ObjectProperty ;
    rdfs:label "має компетенцію"@uk ;
    rdfs:domain hr:Employee ;
    rdfs:range hr:Competence .

hr:hireDate a owl:DatatypeProperty ;
    rdfs:label "дата прийому"@uk ;
    rdfs:domain hr:Employee ;
    rdfs:range xsd:dateTime .

hr:inState a owl:ObjectProperty ;
    rdfs:label "перебуває у стані"@uk ;
    rdfs:domain hr:Person ;
    rdfs:range hr:State .

hr:kpiTarget a owl:DatatypeProperty ;
    rdfs:label "цільове значення KPI"@uk ;
    rdfs:domain hr:KPI ;
    rdfs:range xsd:decimal .

hr:lowers a owl:ObjectProperty ;
    rdfs:label "знижує"@uk ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( hr:Training hr:Motivation hr:Onboarding hr:HRDecision hr:Reward hr:Course ) ] ;
    rdfs:range hr:Metric ;
    rdfs:subPropertyOf hr:affects .

hr:observedBy a owl:ObjectProperty ;
    rdfs:label "спостерігається джерелом"@uk ;
    rdfs:domain hr:SituationTemplate ;
    rdfs:range hr:Sensor .

hr:occurredOn a owl:DatatypeProperty ;
    rdfs:label "дата події"@uk ;
    rdfs:domain hr:Event ;
    rdfs:range xsd:dateTime .

hr:onEvent a owl:ObjectProperty ;
    rdfs:label "подія"@uk ;
    rdfs:domain hr:SituationTemplate ;
    rdfs:range hr:Event .

hr:performsAction a owl:ObjectProperty ;
    rdfs:label "виконує дію"@uk ;
    rdfs:domain hr:SituationTemplate ;
    rdfs:range hr:Action .

hr:planFor a owl:ObjectProperty ;
    rdfs:label "план для"@uk ;
    rdfs:domain hr:TrainingPlan ;
    rdfs:range hr:Employee .

hr:positionTitle a owl:DatatypeProperty ;
    rdfs:label "назва посади"@uk ;
    rdfs:domain hr:Position ;
    rdfs:range xsd:string .

hr:raises a owl:ObjectProperty ;
    rdfs:label "підвищує"@uk ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( hr:Training hr:Motivation hr:Onboarding hr:HRDecision hr:Reward hr:Course ) ] ;
    rdfs:range hr:Metric ;
    rdfs:subPropertyOf hr:affects .

hr:reportedBy a owl:ObjectProperty ;
    rdfs:label "зафіксовано джерелом"@uk ;
    rdfs:domain hr:Event ;
    rdfs:range hr:Sensor .

hr:ruleLeadsTo a owl:ObjectProperty ;
    rdfs:label "призводить до рішення"@uk ;
    rdfs:domain hr:DecisionRule ;
    rdfs:range hr:HRDecision .

hr:salaryAmount a owl:DatatypeProperty ;
    rdfs:label "розмір зарплати"@uk ;
    rdfs:domain hr:Salary ;
    rdfs:range xsd:decimal .

hr:salaryGrade a owl:DatatypeProperty ;
    rdfs:label "тарифний розряд"@uk ;
    rdfs:domain hr:Position ;
    rdfs:range xsd:integer .

hr:storesDocument a owl:ObjectProperty ;
    rdfs:label "зберігає документ"@uk ;
    rdfs:domain hr:InformationSystem ;
    rdfs:range hr:Document .

hr:subProcessOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "є підпроцесом"@uk ;
    rdfs:domain hr:HRProcess ;
    rdfs:range hr:HRProcess ;
    owl:inverseOf hr:hasSubProcess .

hr:submittedResume a owl:ObjectProperty ;
    rdfs:label "подав резюме"@uk ;
    rdfs:domain hr:Candidate ;
    rdfs:range hr:Resume .

hr:tenureMonths a owl:DatatypeProperty ;
    rdfs:label "стаж, місяців"@uk ;
    rdfs:domain hr:Employee ;
    rdfs:range xsd:integer .

hr:toState a owl:ObjectProperty ;
    rdfs:label "новий стан"@uk ;
    rdfs:domain hr:SituationTemplate ;
    rdfs:range hr:State .

hr:trustStatus a owl:AnnotationProperty .

hr:turnoverRate a owl:DatatypeProperty ;
    rdfs:label "рівень плинності, %"@uk ;
    rdfs:domain hr:Turnover ;
    rdfs:range xsd:decimal .

<http://example.org/hr/data> a owl:Ontology ;
    owl:imports <http://example.org/hr> ;
    owl:versionInfo "1.0.0" .

<http://example.org/hr> a owl:Ontology ;
    hr:trustStatus "draft-verified (V2 reasoner HermiT, V4 CQ-тести; V3 — перевірка автором)" ;
    dcterms:created "2026-10-14"^^xsd:date ;
    dcterms:creator "Дячук Роман, ФЕІ-42" ;
    dcterms:source "лекція 7; ЛР 4 (таксономія); ЛР 6 (карта v2, triples_final.csv); Guarino & Welty (2002)" ;
    dcterms:title "Онтологія предметної області «Управління персоналом»"@uk ;
    rdfs:comment "Результат ЛР 7. Зовнішні словники підключено через skos:closeMatch/exactMatch (FOAF, W3C ORG, schema.org, ESCO)."@uk ;
    owl:versionInfo "1.0.0" .

hr:Attestation a owl:Class ;
    rdfs:label "Атестація"@uk ;
    rdfs:comment "Оцінювання, що завершується формальним висновком про відповідність співробітника посаді."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hr:Competence ;
            owl:onProperty hr:evaluates ],
        hr:Appraisal .

hr:bonusQ3 a hr:Bonus,
        owl:NamedIndividual ;
    hr:raises hr:productivityQ3 .

