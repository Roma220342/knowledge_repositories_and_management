hr:TrainingPlan a owl:Class ;
    rdfs:label "Навчальний план"@uk ;
    rdfs:comment "Документ із переліком курсів і строків навчання співробітника."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass hr:Course ;
            owl:onProperty hr:includesCourse ],
        hr:Document .

hr:Appraisal a owl:Class ;
    rdfs:label "Оцінювання"@uk ;
    rdfs:comment "HR-процес визначення результатів і компетенцій співробітників."@uk ;
    rdfs:subClassOf hr:HRProcess .

hr:Candidate a owl:Class ;
    rdfs:label "Кандидат"@uk ;
    rdfs:comment "Особа, яка претендує на вакантну посаду, але ще не уклала трудовий договір."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty hr:candidateFor ;
            owl:someValuesFrom hr:Position ],
        hr:Person .

hr:Document a owl:Class ;
    rdfs:label "Документ"@uk ;
    rdfs:comment "Зафіксований носій відомостей, що використовується в кадровому процесі."@uk .

hr:InformationSystem a owl:Class ;
    rdfs:label "Інформаційна система"@uk ;
    rdfs:comment "Програмна система обліку та обробки кадрових даних."@uk .

hr:Motivation a owl:Class ;
    rdfs:label "Мотивація"@uk ;
    rdfs:comment "HR-процес формування стимулів до результативної праці."@uk ;
    rdfs:subClassOf hr:HRProcess .

hr:Onboarding a owl:Class ;
    rdfs:label "Онбординг"@uk ;
    rdfs:comment "HR-процес адаптації нового співробітника в організації."@uk ;
    rdfs:subClassOf hr:HRProcess .

hr:Person a owl:Class ;
    rdfs:label "Особа"@uk ;
    rdfs:comment "Людина, що взаємодіє з організацією у сфері праці."@uk ;
    skos:exactMatch foaf:Person .

hr:Training a owl:Class ;
    rdfs:label "Навчання та розвиток"@uk ;
    rdfs:comment "HR-процес підвищення компетенцій співробітників."@uk ;
    rdfs:subClassOf hr:HRProcess .

hr:andriy a hr:Employee,
        owl:NamedIndividual ;
    hr:completedCourse hr:pythonAdvancedCourse ;
    hr:directManager hr:ivan ;
    hr:employeeId "E-005"^^xsd:string ;
    hr:fullName "Андрій Мельник"^^xsd:string ;
    hr:hasCompetence hr:pythonProgramming,
        hr:teamCommunication ;
    hr:hireDate "2021-09-01T00:00:00"^^xsd:dateTime ;
    hr:inState hr:stateActive ;
    hr:occupies hr:pythonDeveloperPost ;
    hr:productivityScore 9.1 ;
    hr:tenureMonths 61 .

hr:maria a hr:Employee,
        owl:NamedIndividual ;
    hr:completedCourse hr:negotiationCourse ;
    hr:directManager hr:ivan ;
    hr:employeeId "E-004"^^xsd:string ;
    hr:fullName "Марія Гончар"^^xsd:string ;
    hr:hasCompetence hr:pythonProgramming,
        hr:teamCommunication ;
    hr:hireDate "2026-05-02T00:00:00"^^xsd:dateTime ;
    hr:inState hr:stateProbation ;
    hr:occupies hr:pythonDeveloperPost ;
    hr:productivityScore 6.5 ;
    hr:tenureMonths 5 .

hr:petro a hr:Employee,
        owl:NamedIndividual ;
    hr:directManager hr:ivan ;
    hr:employeeId "E-003"^^xsd:string ;
    hr:fullName "Петро Бондар"^^xsd:string ;
    hr:hasCompetence hr:pythonProgramming ;
    hr:hireDate "2023-01-10T00:00:00"^^xsd:dateTime ;
    hr:inState hr:stateActive ;
    hr:occupies hr:pythonDeveloperPost ;
    hr:productivityScore 4.2 ;
    hr:tenureMonths 44 .

hr:recruiterPost a hr:Position,
        owl:NamedIndividual ;
    hr:positionTitle "Рекрутер"^^xsd:string ;
    hr:requiresCompetence hr:negotiation ;
    hr:salaryGrade 4 .

hr:sensorHRIS a hr:HRISSensor,
        owl:NamedIndividual .

hr:Reward a owl:Class ;
    rdfs:label "Винагорода"@uk ;
    rdfs:comment "Грошова виплата або інша компенсація за виконану працю."@uk .

hr:Sensor a owl:Class ;
    rdfs:label "Джерело даних"@uk ;
    rdfs:comment "Система, що регулярно фіксує показники та генерує події."@uk .

hr:LowProductivityEvent a owl:Class ;
    rdfs:label "Низька продуктивність"@uk ;
    rdfs:comment "Подія, що фіксує нижчу за порогову продуктивність співробітника за квартал."@uk ;
    rdfs:subClassOf hr:Event .

hr:emp013 a hr:Manager,
        owl:NamedIndividual ;
    hr:directManager hr:olena ;
    hr:employeeId "E-013"^^xsd:string ;
    hr:fullName "Остап Павлюк"^^xsd:string ;
    hr:hasCompetence hr:hrAnalytics,
        hr:negotiation,
        hr:teamCommunication ;
    hr:hireDate "2019-11-01T00:00:00"^^xsd:dateTime ;
    hr:inState hr:stateActive ;
    hr:occupies hr:teamLeadPost ;
    hr:productivityScore 9.5 ;
    hr:tenureMonths 84 .

hr:pythonAdvancedCourse a hr:Course,
        owl:NamedIndividual ;
    hr:courseHours 40 ;
    hr:courseTitle "Python Advanced"^^xsd:string ;
    hr:raises hr:productivityQ3 .

hr:Action a owl:Class ;
    rdfs:label "Дія"@uk ;
    rdfs:comment "Операція, що виконується в HR-процесі у відповідь на подію."@uk .

hr:Metric a owl:Class ;
    rdfs:label "Показник"@uk ;
    rdfs:comment "Кількісна характеристика стану чи результату HR-діяльності."@uk .

hr:Competence a owl:Class ;
    rdfs:label "Компетенція"@uk ;
    rdfs:comment "Здатність виконувати завдання, що поєднує знання, навички та поведінкові ознаки."@uk ;
    skos:closeMatch esco:Skill .

hr:Event a owl:Class ;
    rdfs:label "Подія"@uk ;
    rdfs:comment "Факт, що фіксується в HR-системах і може змінити стан співробітника."@uk .

hr:HRDecision a owl:Class ;
    rdfs:label "Кадрове рішення"@uk ;
    rdfs:comment "Управлінське рішення щодо прийому, переміщення, винагороди чи звільнення працівника."@uk .

hr:State a owl:Class ;
    rdfs:label "Стан"@uk ;
    rdfs:comment "Сукупність умов, що характеризує перебування співробітника чи кандидата в HR-процесі."@uk .

hr:productivityQ3 a hr:Productivity,
        owl:NamedIndividual .

hr:Manager a owl:Class ;
    rdfs:label "Керівник"@uk ;
    rdfs:comment "Співробітник, який відповідає за підрозділ і ухвалює кадрові рішення щодо підлеглих."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hr:HRDecision ;
            owl:onProperty hr:makesDecision ],
        hr:Employee .

hr:negotiationCourse a hr:Course,
        owl:NamedIndividual ;
    hr:courseHours 16 ;
    hr:courseTitle "Ефективні перемовини"^^xsd:string ;
    hr:raises hr:productivityQ3 .

hr:sensorKPI a hr:KPISensor,
        owl:NamedIndividual .

hr:Course a owl:Class ;
    rdfs:label "Курс навчання"@uk ;
    rdfs:comment "Структурований навчальний модуль, що розвиває визначені компетенції."@uk ;
    skos:exactMatch schema1:Course .

hr:HRProcess a owl:Class ;
    rdfs:label "HR-процес"@uk ;
    rdfs:comment "Повторювана послідовність дій у межах управління персоналом."@uk ;
    skos:relatedMatch org:OrganizationalUnit .

hr:hrAnalytics a hr:HardSkill,
        owl:NamedIndividual .

hr:olena a hr:Manager,
        owl:NamedIndividual ;
    hr:appliesRule hr:ruleLowProductivity ;
    hr:employeeId "E-001"^^xsd:string ;
    hr:fullName "Олена Коваль"^^xsd:string ;
    hr:hasCompetence hr:hrAnalytics,
        hr:negotiation ;
    hr:hireDate "2019-03-01T00:00:00"^^xsd:dateTime ;
    hr:inState hr:stateActive ;
    hr:makesDecision hr:dismissalProposal1 ;
    hr:occupies hr:hrManagerPost ;
    hr:productivityScore 7.9 ;
    hr:tenureMonths 88 .

hr:SituationTemplate a owl:Class ;
    rdfs:label "Шаблон ситуації"@uk ;
    rdfs:comment "Формалізований опис переходу між станами за подією та умовою."@uk .

hr:CourseCompletedEvent a owl:Class ;
    rdfs:label "Завершення курсу"@uk ;
    rdfs:comment "Подія, що фіксує завершення співробітником курсу навчання."@uk ;
    rdfs:subClassOf hr:Event .

hr:Position a owl:Class ;
    rdfs:label "Посада"@uk ;
    rdfs:comment "Штатна одиниця організаційної структури з визначеними обов'язками та вимогами до виконавця."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty hr:requiresCompetence ;
            owl:someValuesFrom hr:Competence ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass hr:Competence ;
            owl:onProperty hr:requiresCompetence ] ;
    skos:closeMatch org:Post .

hr:ivan a hr:Manager,
        owl:NamedIndividual ;
    hr:directManager hr:olena ;
    hr:employeeId "E-002"^^xsd:string ;
    hr:fullName "Іван Шевчук"^^xsd:string ;
    hr:hasCompetence hr:negotiation,
        hr:teamCommunication ;
    hr:hireDate "2020-06-15T00:00:00"^^xsd:dateTime ;
    hr:inState hr:stateActive ;
    hr:makesDecision hr:promotion1 ;
    hr:occupies hr:teamLeadPost ;
    hr:productivityScore 8.6 ;
    hr:tenureMonths 76 .

hr:sensorLMS a hr:LMSSensor,
        owl:NamedIndividual .

hr:pythonProgramming a hr:HardSkill,
        owl:NamedIndividual .

hr:negotiation a hr:SoftSkill,
        owl:NamedIndividual .

hr:teamCommunication a hr:SoftSkill,
        owl:NamedIndividual .

hr:pythonDeveloperPost a hr:Position,
        owl:NamedIndividual ;
    hr:positionTitle "Python-розробник"^^xsd:string ;
    hr:requiresCompetence hr:pythonProgramming,
        hr:teamCommunication ;
    hr:salaryGrade 5 .

hr:stateActive a hr:ActiveState,
        owl:NamedIndividual .

hr:Employee a owl:Class ;
    rdfs:label "Співробітник"@uk ;
    rdfs:comment "Особа, яка перебуває в трудових відносинах з організацією."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty hr:occupies ;
            owl:someValuesFrom hr:Position ],
        [ a owl:Restriction ;
            owl:onClass hr:Position ;
            owl:onProperty hr:occupies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass hr:Manager ;
            owl:onProperty hr:directManager ],
        hr:Person ;
    skos:broadMatch schema1:Person .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:CandidateState hr:OnboardingState hr:ProbationState hr:ActiveState hr:UnderReviewState hr:DismissedState ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:Salary hr:Bonus ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:HireEvent hr:ProbationReviewEvent hr:LowProductivityEvent hr:CourseCompletedEvent hr:ResignationRequestEvent ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:Manager hr:Recruiter ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:Productivity hr:Turnover hr:KPI ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:SoftSkill hr:HardSkill ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:ConfirmEmploymentAction hr:InitiateDismissalAction hr:StartOnboardingAction hr:AssignCourseAction hr:UpdateCompetenceAction hr:CloseRecordAction ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:Resume hr:PositionProfile hr:TrainingPlan ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:Promotion hr:Dismissal ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:HRIS hr:LMS ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:Employee hr:Candidate ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:KPISensor hr:LMSSensor hr:HRISSensor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:Recruitment hr:Appraisal hr:Training hr:Motivation hr:Interview hr:Onboarding ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hr:Person hr:Position hr:Competence hr:HRProcess hr:HRDecision hr:DecisionRule hr:Metric hr:Reward hr:Document hr:Course hr:InformationSystem hr:Event hr:State hr:Action hr:Sensor hr:SituationTemplate ) .

[] a owl:AllDifferent ;
    owl:distinctMembers ( hr:personnelManagement hr:recruitment1 hr:interview1 hr:onboarding1 hr:appraisal1 hr:attestation2026 hr:training1 hr:motivation1 hr:pythonDeveloperPost hr:teamLeadPost hr:hrManagerPost hr:recruiterPost hr:pythonProgramming hr:hrAnalytics hr:negotiation hr:teamCommunication hr:olena hr:ivan hr:petro hr:maria hr:andriy hr:sofia hr:candidate1 hr:candidate2 hr:negotiationCourse hr:pythonAdvancedCourse hr:hris1 hr:lms1 hr:productivityQ3 hr:turnover2026 hr:kpiSprint hr:salaryIvan hr:bonusQ3 hr:promotion1 hr:dismissalProposal1 hr:ruleLowProductivity hr:resume1 hr:resume2 hr:positionProfilePython hr:trainingPlanPetro hr:stateCandidate hr:stateOnboarding hr:stateProbation hr:stateActive hr:stateUnderReview hr:stateDismissed hr:eventHire1 hr:eventProbationMaria hr:eventLowProdPetro hr:eventResignation1 hr:eventCourseAndriy hr:actionConfirmEmployment hr:actionInitiateDismissal hr:actionStartOnboarding hr:actionAssignCourse hr:actionUpdateCompetence hr:actionCloseRecord hr:sensorKPI hr:sensorLMS hr:sensorHRIS hr:situationS1 hr:situationS2 hr:situationS3 hr:situationS4 hr:situationS5 hr:situationS6 ) .

