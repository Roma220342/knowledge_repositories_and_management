ns1:includesCourse a owl:ObjectProperty ;
    rdfs:label "включає курс"@uk ;
    rdfs:domain ns1:TrainingPlan ;
    rdfs:range ns1:Course .

ns1:isOccupiedBy a owl:ObjectProperty ;
    rdfs:label "обіймається"@uk ;
    rdfs:domain ns1:Position ;
    rdfs:range ns1:Employee .

ns1:lms1 a ns1:LMS,
        owl:NamedIndividual ;
    ns1:storesDocument ns1:trainingPlanPetro ;
    ns1:storesRecordOf ns1:andriy,
        ns1:maria .

ns1:makesDecision a owl:ObjectProperty ;
    rdfs:label "ухвалює"@uk ;
    rdfs:domain ns1:Manager ;
    rdfs:range ns1:HRDecision .

ns1:manages a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "керує"@uk ;
    rdfs:domain ns1:Manager ;
    rdfs:range ns1:Employee .

ns1:personnelManagement a ns1:HRProcess,
        owl:NamedIndividual ;
    ns1:hasSubProcess ns1:appraisal1,
        ns1:motivation1,
        ns1:recruitment1,
        ns1:training1 .

ns1:reportsTo a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "підпорядковується"@uk ;
    rdfs:domain ns1:Employee ;
    rdfs:range ns1:Manager ;
    owl:inverseOf ns1:manages ;
    skos:closeMatch org:reportsTo .

ns1:requiresDocument a owl:ObjectProperty ;
    rdfs:label "вимагає документ"@uk ;
    rdfs:domain ns1:Recruitment ;
    rdfs:range ns1:PositionProfile .

ns1:salaryIvan a ns1:Salary,
        owl:NamedIndividual ;
    ns1:salaryAmount 3200.00 .

ns1:situationS1 a ns1:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Підтвердження після випробувального терміну"@uk ;
    ns1:fromState ns1:stateProbation ;
    ns1:guard "productivityScore ≥ 6.0" ;
    ns1:observedBy ns1:sensorKPI ;
    ns1:onEvent ns1:eventProbationMaria ;
    ns1:performsAction ns1:actionConfirmEmployment ;
    ns1:toState ns1:stateActive .

ns1:situationS2 a ns1:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Ініціювання звільнення за низької продуктивності"@uk ;
    ns1:fromState ns1:stateActive ;
    ns1:guard "productivityScore < 5.0 три квартали поспіль" ;
    ns1:observedBy ns1:sensorKPI ;
    ns1:onEvent ns1:eventLowProdPetro ;
    ns1:performsAction ns1:actionInitiateDismissal ;
    ns1:toState ns1:stateUnderReview .

ns1:situationS3 a ns1:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Початок адаптації нового співробітника"@uk ;
    ns1:fromState ns1:stateCandidate ;
    ns1:guard "рішення про прийом схвалено керівником" ;
    ns1:observedBy ns1:sensorHRIS ;
    ns1:onEvent ns1:eventHire1 ;
    ns1:performsAction ns1:actionStartOnboarding ;
    ns1:toState ns1:stateOnboarding .

ns1:situationS4 a ns1:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Завершення курсу навчання"@uk ;
    ns1:fromState ns1:stateActive ;
    ns1:guard "courseHours ≥ 8" ;
    ns1:observedBy ns1:sensorLMS ;
    ns1:onEvent ns1:eventCourseAndriy ;
    ns1:performsAction ns1:actionUpdateCompetence ;
    ns1:toState ns1:stateActive .

ns1:situationS5 a ns1:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Низька продуктивність: призначення курсу"@uk ;
    ns1:fromState ns1:stateActive ;
    ns1:guard "5.0 ≤ productivityScore < 6.5" ;
    ns1:observedBy ns1:sensorKPI ;
    ns1:onEvent ns1:eventLowProdPetro ;
    ns1:performsAction ns1:actionAssignCourse ;
    ns1:toState ns1:stateActive .

ns1:situationS6 a ns1:SituationTemplate,
        owl:NamedIndividual ;
    rdfs:label "Заява про звільнення"@uk ;
    ns1:fromState ns1:stateActive ;
    ns1:guard "заява зареєстрована в HRIS" ;
    ns1:observedBy ns1:sensorHRIS ;
    ns1:onEvent ns1:eventResignation1 ;
    ns1:performsAction ns1:actionCloseRecord ;
    ns1:toState ns1:stateDismissed .

ns1:storesRecordOf a owl:ObjectProperty ;
    rdfs:label "зберігає дані про"@uk ;
    rdfs:domain ns1:InformationSystem ;
    rdfs:range ns1:Employee .

ns1:ActiveState a owl:Class ;
    rdfs:label "Активний стан"@uk ;
    rdfs:comment "Стан співробітника, що працює на постійній основі."@uk ;
    rdfs:subClassOf ns1:State .

ns1:AssignCourseAction a owl:Class ;
    rdfs:label "Призначення курсу"@uk ;
    rdfs:comment "Дія призначення співробітнику курсу навчання."@uk ;
    rdfs:subClassOf ns1:Action .

ns1:Bonus a owl:Class ;
    rdfs:label "Премія"@uk ;
    rdfs:comment "Винагорода, що виплачується додатково за досягнуті результати."@uk ;
    rdfs:subClassOf ns1:Reward .

ns1:CandidateState a owl:Class ;
    rdfs:label "Стан кандидата"@uk ;
    rdfs:comment "Стан особи, яка перебуває на етапі відбору."@uk ;
    rdfs:subClassOf ns1:State .

ns1:CloseRecordAction a owl:Class ;
    rdfs:label "Закриття кадрового запису"@uk ;
    rdfs:comment "Дія завершення ведення активного кадрового запису."@uk ;
    rdfs:subClassOf ns1:Action .

ns1:ConfirmEmploymentAction a owl:Class ;
    rdfs:label "Підтвердження працевлаштування"@uk ;
    rdfs:comment "Дія переведення співробітника на постійну роботу."@uk ;
    rdfs:subClassOf ns1:Action .

ns1:Dismissal a owl:Class ;
    rdfs:label "Звільнення"@uk ;
    rdfs:comment "Кадрове рішення про припинення трудових відносин."@uk ;
    rdfs:subClassOf ns1:HRDecision .

ns1:DismissedState a owl:Class ;
    rdfs:label "Стан звільнення"@uk ;
    rdfs:comment "Стан особи, трудові відносини з якою припинено."@uk ;
    rdfs:subClassOf ns1:State .

ns1:HRIS a owl:Class ;
    rdfs:label "HRIS"@uk ;
    rdfs:comment "Інформаційна система обліку кадрових даних і підтримки HR-процесів."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Employee ;
            owl:onProperty ns1:storesRecordOf ],
        ns1:InformationSystem .

ns1:HRISSensor a owl:Class ;
    rdfs:label "Джерело HRIS"@uk ;
    rdfs:comment "Джерело даних, що фіксує кадрові події в HRIS."@uk ;
    rdfs:subClassOf ns1:Sensor .

ns1:HireEvent a owl:Class ;
    rdfs:label "Подія найму"@uk ;
    rdfs:comment "Подія, що фіксує ухвалення рішення про прийом кандидата."@uk ;
    rdfs:subClassOf ns1:Event .

ns1:InitiateDismissalAction a owl:Class ;
    rdfs:label "Ініціювання звільнення"@uk ;
    rdfs:comment "Дія запуску процедури звільнення."@uk ;
    rdfs:subClassOf ns1:Action .

ns1:Interview a owl:Class ;
    rdfs:label "Співбесіда"@uk ;
    rdfs:comment "HR-процес розмови з кандидатом для оцінки його відповідності посаді."@uk ;
    rdfs:subClassOf ns1:HRProcess .

ns1:KPISensor a owl:Class ;
    rdfs:label "Джерело KPI"@uk ;
    rdfs:comment "Джерело даних, що фіксує значення KPI та продуктивності."@uk ;
    rdfs:subClassOf ns1:Sensor .

ns1:LMS a owl:Class ;
    rdfs:label "LMS"@uk ;
    rdfs:comment "Інформаційна система управління навчанням, що зберігає курси та результати їх проходження."@uk ;
    rdfs:subClassOf ns1:InformationSystem .

ns1:LMSSensor a owl:Class ;
    rdfs:label "Джерело LMS"@uk ;
    rdfs:comment "Джерело даних, що фіксує проходження навчальних курсів."@uk ;
    rdfs:subClassOf ns1:Sensor .

ns1:OnboardingState a owl:Class ;
    rdfs:label "Стан адаптації"@uk ;
    rdfs:comment "Стан нового співробітника в період адаптації."@uk ;
    rdfs:subClassOf ns1:State .

ns1:ProbationReviewEvent a owl:Class ;
    rdfs:label "Підсумок випробувального терміну"@uk ;
    rdfs:comment "Подія, що фіксує оцінку результатів випробувального терміну."@uk ;
    rdfs:subClassOf ns1:Event .

ns1:ProbationState a owl:Class ;
    rdfs:label "Випробувальний термін"@uk ;
    rdfs:comment "Стан співробітника в період випробування."@uk ;
    rdfs:subClassOf ns1:State .

ns1:Productivity a owl:Class ;
    rdfs:label "Продуктивність"@uk ;
    rdfs:comment "Показник відношення результатів роботи співробітника до витрат часу та ресурсів."@uk ;
    rdfs:subClassOf ns1:Metric .

ns1:Promotion a owl:Class ;
    rdfs:label "Підвищення"@uk ;
    rdfs:comment "Кадрове рішення про переведення співробітника на вищу посаду."@uk ;
    rdfs:subClassOf ns1:HRDecision .

ns1:ResignationRequestEvent a owl:Class ;
    rdfs:label "Заява про звільнення"@uk ;
    rdfs:comment "Подія, що фіксує подання співробітником заяви про звільнення."@uk ;
    rdfs:subClassOf ns1:Event .

ns1:StartOnboardingAction a owl:Class ;
    rdfs:label "Запуск онбордингу"@uk ;
    rdfs:comment "Дія початку адаптації нового співробітника."@uk ;
    rdfs:subClassOf ns1:Action .

ns1:UnderReviewState a owl:Class ;
    rdfs:label "Стан розгляду"@uk ;
    rdfs:comment "Стан співробітника, щодо якого розглядається кадрове рішення."@uk ;
    rdfs:subClassOf ns1:State .

ns1:UpdateCompetenceAction a owl:Class ;
    rdfs:label "Оновлення компетенції"@uk ;
    rdfs:comment "Дія оновлення рівня компетенції співробітника в HRIS."@uk ;
    rdfs:subClassOf ns1:Action .

ns1:actionAssignCourse a ns1:AssignCourseAction,
        owl:NamedIndividual .

ns1:actionCloseRecord a ns1:CloseRecordAction,
        owl:NamedIndividual .

ns1:actionConfirmEmployment a ns1:ConfirmEmploymentAction,
        owl:NamedIndividual .

ns1:actionInitiateDismissal a ns1:InitiateDismissalAction,
        owl:NamedIndividual .

ns1:actionStartOnboarding a ns1:StartOnboardingAction,
        owl:NamedIndividual .

ns1:actionUpdateCompetence a ns1:UpdateCompetenceAction,
        owl:NamedIndividual .

ns1:affects a owl:ObjectProperty ;
    rdfs:label "впливає на"@uk ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Training ns1:Motivation ns1:Onboarding ns1:HRDecision ns1:Reward ns1:Course ) ] ;
    rdfs:range ns1:Metric .

ns1:appraisal1 a ns1:Appraisal,
        owl:NamedIndividual ;
    ns1:evaluatesMetric ns1:productivityQ3 ;
    ns1:hasSubProcess ns1:attestation2026 .

ns1:attestation2026 a ns1:Attestation,
        owl:NamedIndividual ;
    ns1:evaluates ns1:pythonProgramming,
        ns1:teamCommunication ;
    ns1:evaluatesMetric ns1:kpiSprint .

ns1:directManager a owl:ObjectProperty ;
    rdfs:label "безпосередній керівник"@uk ;
    rdfs:domain ns1:Employee ;
    rdfs:range ns1:Manager ;
    rdfs:subPropertyOf ns1:reportsTo .

