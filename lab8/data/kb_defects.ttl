    rdfs:label "Винагорода"@uk ;
    rdfs:comment "Грошова виплата або інша компенсація за виконану працю."@uk .

ns1:Sensor a owl:Class ;
    rdfs:label "Джерело даних"@uk ;
    rdfs:comment "Система, що регулярно фіксує показники та генерує події."@uk .

ns1:LowProductivityEvent a owl:Class ;
    rdfs:label "Низька продуктивність"@uk ;
    rdfs:comment "Подія, що фіксує нижчу за порогову продуктивність співробітника за квартал."@uk ;
    rdfs:subClassOf ns1:Event .

