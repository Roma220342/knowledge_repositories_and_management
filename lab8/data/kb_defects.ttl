        owl:NamedIndividual ;
    ns1:candidateFor ns1:pythonProgramming ;
    ns1:fullName "Дмитро Савчук"^^xsd:string ;
    ns1:inState ns1:stateCandidate ;
    ns1:submittedResume ns1:resume1 .

