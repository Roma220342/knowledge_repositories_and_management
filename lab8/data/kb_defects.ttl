@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://example.org/hr#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:HighPerformer a owl:Class ;
    rdfs:label "Співробітник із високою продуктивністю"@uk ;
    rdfs:comment "Співробітник, продуктивність якого не нижча за 8 балів."@uk ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Employee [ a owl:Restriction ;
                        owl:onProperty ns1:productivityScore ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 8.0 ] ) ] ] ) ] .

ns1:LowPerformer a owl:Class ;
    rdfs:label "Співробітник із низькою продуктивністю"@uk ;
    rdfs:comment "Співробітник, продуктивність якого нижча за 5 балів."@uk ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Employee [ a owl:Restriction ;
                        owl:onProperty ns1:productivityScore ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:maxExclusive 5.0 ] ) ] ] ) ] .

ns1:ManagedEmployee a owl:Class ;
    rdfs:label "Підпорядкований співробітник"@uk ;
    rdfs:comment "Співробітник, що має безпосереднього керівника."@uk ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Employee [ a owl:Restriction ;
                        owl:onProperty ns1:directManager ;
                        owl:someValuesFrom ns1:Manager ] ) ] .

ns1:TrainedEmployee a owl:Class ;
    rdfs:label "Співробітник, що пройшов навчання"@uk ;
    rdfs:comment "Співробітник, який завершив принаймні один курс навчання."@uk ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:Employee [ a owl:Restriction ;
                        owl:onProperty ns1:completedCourse ;
                        owl:someValuesFrom ns1:Course ] ) ] .

ns1:appliesRule a owl:ObjectProperty ;
    rdfs:label "застосовує"@uk ;
    rdfs:domain ns1:Manager ;
    rdfs:range ns1:DecisionRule .

ns1:concernsEmployee a owl:ObjectProperty ;
    rdfs:label "стосується співробітника"@uk ;
    rdfs:domain ns1:Event ;
    rdfs:range ns1:Employee .

ns1:courseHours a owl:DatatypeProperty ;
    rdfs:label "тривалість курсу, год"@uk ;
    rdfs:domain ns1:Course ;
    rdfs:range xsd:integer .

ns1:courseTitle a owl:DatatypeProperty ;
    rdfs:label "назва курсу"@uk ;
    rdfs:domain ns1:Course ;
    rdfs:range xsd:string .

ns1:decisionAbout a owl:ObjectProperty ;
    rdfs:label "стосується співробітника"@uk ;
    rdfs:domain ns1:HRDecision ;
    rdfs:range ns1:Employee .

ns1:employeeId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "табельний номер"@uk ;
    rdfs:domain ns1:Employee ;
    rdfs:range xsd:string .

ns1:evaluatesMetric a owl:ObjectProperty ;
    rdfs:label "оцінює показник"@uk ;
    rdfs:domain ns1:Appraisal ;
    rdfs:range ns1:Metric .

