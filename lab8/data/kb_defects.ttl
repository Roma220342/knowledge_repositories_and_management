    owl:distinctMembers ( ns1:personnelManagement ns1:recruitment1 ns1:interview1 ns1:onboarding1 ns1:appraisal1 ns1:attestation2026 ns1:training1 ns1:motivation1 ns1:pythonDeveloperPost ns1:teamLeadPost ns1:hrManagerPost ns1:recruiterPost ns1:pythonProgramming ns1:hrAnalytics ns1:negotiation ns1:teamCommunication ns1:olena ns1:ivan ns1:petro ns1:maria ns1:andriy ns1:sofia ns1:candidate1 ns1:candidate2 ns1:negotiationCourse ns1:pythonAdvancedCourse ns1:hris1 ns1:lms1 ns1:productivityQ3 ns1:turnover2026 ns1:kpiSprint ns1:salaryIvan ns1:bonusQ3 ns1:promotion1 ns1:dismissalProposal1 ns1:ruleLowProductivity ns1:resume1 ns1:resume2 ns1:positionProfilePython ns1:trainingPlanPetro ns1:stateCandidate ns1:stateOnboarding ns1:stateProbation ns1:stateActive ns1:stateUnderReview ns1:stateDismissed ns1:eventHire1 ns1:eventProbationMaria ns1:eventLowProdPetro ns1:eventResignation1 ns1:eventCourseAndriy ns1:actionConfirmEmployment ns1:actionInitiateDismissal ns1:actionStartOnboarding ns1:actionAssignCourse ns1:actionUpdateCompetence ns1:actionCloseRecord ns1:sensorKPI ns1:sensorLMS ns1:sensorHRIS ns1:situationS1 ns1:situationS2 ns1:situationS3 ns1:situationS4 ns1:situationS5 ns1:situationS6 ) .

