ns1:stateActive a ns1:ActiveState,
        owl:NamedIndividual .

ns1:Employee a owl:Class ;
    rdfs:label "Співробітник"@uk ;
    rdfs:comment "Особа, яка перебуває в трудових відносинах з організацією."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:occupies ;
            owl:someValuesFrom ns1:Position ],
        [ a owl:Restriction ;
            owl:onClass ns1:Position ;
            owl:onProperty ns1:occupies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ns1:Manager ;
            owl:onProperty ns1:directManager ],
        ns1:Person ;
    skos:broadMatch <http://schema.org/Person> .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:KPISensor ns1:LMSSensor ns1:HRISSensor ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Recruitment ns1:Appraisal ns1:Training ns1:Motivation ns1:Interview ns1:Onboarding ) .

[] a owl:AllDisjointClasses ;
    owl:members ( ns1:Person ns1:Position ns1:Competence ns1:HRProcess ns1:HRDecision ns1:DecisionRule ns1:Metric ns1:Reward ns1:Document ns1:Course ns1:InformationSystem ns1:Event ns1:State ns1:Action ns1:Sensor ns1:SituationTemplate ) .

