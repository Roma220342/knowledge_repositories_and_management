ns1:fromState a owl:ObjectProperty ;
    rdfs:label "початковий стан"@uk ;
    rdfs:domain ns1:SituationTemplate ;
    rdfs:range ns1:State .

ns1:fullName a owl:DatatypeProperty ;
    rdfs:label "ПІБ"@uk ;
    rdfs:domain ns1:Person ;
    rdfs:range xsd:string ;
    skos:exactMatch foaf:name .

ns1:guard a owl:DatatypeProperty ;
    rdfs:label "умова (guard)"@uk ;
    rdfs:domain ns1:SituationTemplate ;
    rdfs:range xsd:string .

ns1:hasCompetence a owl:ObjectProperty ;
    rdfs:label "має компетенцію"@uk ;
    rdfs:domain ns1:Employee ;
    rdfs:range ns1:Competence .

ns1:hireDate a owl:DatatypeProperty ;
    rdfs:label "дата прийому"@uk ;
    rdfs:domain ns1:Employee ;
    rdfs:range xsd:dateTime .

ns1:inState a owl:ObjectProperty ;
    rdfs:label "перебуває у стані"@uk ;
    rdfs:domain ns1:Person ;
    rdfs:range ns1:State .

ns1:kpiTarget a owl:DatatypeProperty ;
    rdfs:label "цільове значення KPI"@uk ;
    rdfs:domain ns1:KPI ;
    rdfs:range xsd:decimal .

ns1:lowers a owl:ObjectProperty ;
    rdfs:label "знижує"@uk ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Training ns1:Motivation ns1:Onboarding ns1:HRDecision ns1:Reward ns1:Course ) ] ;
    rdfs:range ns1:Metric ;
    rdfs:subPropertyOf ns1:affects .

ns1:observedBy a owl:ObjectProperty ;
    rdfs:label "спостерігається джерелом"@uk ;
    rdfs:domain ns1:SituationTemplate ;
    rdfs:range ns1:Sensor .

ns1:occurredOn a owl:DatatypeProperty ;
    rdfs:label "дата події"@uk ;
    rdfs:domain ns1:Event ;
    rdfs:range xsd:dateTime .

ns1:onEvent a owl:ObjectProperty ;
    rdfs:label "подія"@uk ;
    rdfs:domain ns1:SituationTemplate ;
    rdfs:range ns1:Event .

ns1:performsAction a owl:ObjectProperty ;
    rdfs:label "виконує дію"@uk ;
    rdfs:domain ns1:SituationTemplate ;
    rdfs:range ns1:Action .

ns1:planFor a owl:ObjectProperty ;
    rdfs:label "план для"@uk ;
    rdfs:domain ns1:TrainingPlan ;
    rdfs:range ns1:Employee .

ns1:positionTitle a owl:DatatypeProperty ;
    rdfs:label "назва посади"@uk ;
    rdfs:domain ns1:Position ;
    rdfs:range xsd:string .

ns1:raises a owl:ObjectProperty ;
    rdfs:label "підвищує"@uk ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns1:Training ns1:Motivation ns1:Onboarding ns1:HRDecision ns1:Reward ns1:Course ) ] ;
    rdfs:range ns1:Metric ;
    rdfs:subPropertyOf ns1:affects .

ns1:reportedBy a owl:ObjectProperty ;
    rdfs:label "зафіксовано джерелом"@uk ;
    rdfs:domain ns1:Event ;
    rdfs:range ns1:Sensor .

ns1:ruleLeadsTo a owl:ObjectProperty ;
    rdfs:label "призводить до рішення"@uk ;
    rdfs:domain ns1:DecisionRule ;
    rdfs:range ns1:HRDecision .

ns1:salaryAmount a owl:DatatypeProperty ;
    rdfs:label "розмір зарплати"@uk ;
    rdfs:domain ns1:Salary ;
    rdfs:range xsd:decimal .

ns1:salaryGrade a owl:DatatypeProperty ;
    rdfs:label "тарифний розряд"@uk ;
    rdfs:domain ns1:Position ;
    rdfs:range xsd:integer .

ns1:storesDocument a owl:ObjectProperty ;
    rdfs:label "зберігає документ"@uk ;
    rdfs:domain ns1:InformationSystem ;
    rdfs:range ns1:Document .

ns1:subProcessOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "є підпроцесом"@uk ;
    rdfs:domain ns1:HRProcess ;
    rdfs:range ns1:HRProcess ;
    owl:inverseOf ns1:hasSubProcess .

ns1:submittedResume a owl:ObjectProperty ;
    rdfs:label "подав резюме"@uk ;
    rdfs:domain ns1:Candidate ;
    rdfs:range ns1:Resume .

ns1:tenureMonths a owl:DatatypeProperty ;
    rdfs:label "стаж, місяців"@uk ;
    rdfs:domain ns1:Employee ;
    rdfs:range xsd:integer .

ns1:toState a owl:ObjectProperty ;
    rdfs:label "новий стан"@uk ;
    rdfs:domain ns1:SituationTemplate ;
    rdfs:range ns1:State .

ns1:trustStatus a owl:AnnotationProperty .

ns1:turnoverRate a owl:DatatypeProperty ;
    rdfs:label "рівень плинності, %"@uk ;
    rdfs:domain ns1:Turnover ;
    rdfs:range xsd:decimal .

<http://example.org/hr/data> a owl:Ontology ;
    owl:imports <http://example.org/hr> ;
    owl:versionInfo "1.0.0" .

<http://example.org/hr> a owl:Ontology ;
    ns1:trustStatus "draft-verified (V2 reasoner HermiT, V4 CQ-тести; V3 — перевірка автором)" ;
    dcterms:created "2026-10-14"^^xsd:date ;
    dcterms:creator "Дячук Роман, ФЕІ-42" ;
    dcterms:source "лекція 7; ЛР 4 (таксономія); ЛР 6 (карта v2, triples_final.csv); Guarino & Welty (2002)" ;
    dcterms:title "Онтологія предметної області «Управління персоналом»"@uk ;
    rdfs:comment "Результат ЛР 7. Зовнішні словники підключено через skos:closeMatch/exactMatch (FOAF, W3C ORG, schema.org, ESCO)."@uk ;
    owl:versionInfo "1.0.0" .

ns1:Attestation a owl:Class ;
    rdfs:label "Атестація"@uk ;
    rdfs:comment "Оцінювання, що завершується формальним висновком про відповідність співробітника посаді."@uk ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ns1:Competence ;
            owl:onProperty ns1:evaluates ],
        ns1:Appraisal .

ns1:bonusQ3 a ns1:Bonus,
        owl:NamedIndividual ;
    ns1:raises ns1:productivityQ3 .

